# Copy to .env, then generate distinct values with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres
ENCRYPTION_KEY=change-me-encryption
DEFAULT_WORKSPACE_ID=default
FRONTEND_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Configure only providers that send webhooks to this deployment.
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_GITLAB=
WEBHOOK_SECRET_CIRCLECI=
WEBHOOK_SECRET_VERCEL=
WEBHOOK_SECRET_NETLIFY=
# Shared HMAC secret used only by infra/aws/eventbridge-relay.
AWS_RELAY_SECRET=
